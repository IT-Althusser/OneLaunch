# Token Plan API key (never commit a real key)
MODEL_ROUTER_API_KEY=sk-xxx
MODEL_ROUTER_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
PORT=3101
# MODEL_ROUTER_VISION_MODEL=qwen3.6-plus  # 可选，白底图视觉质检模型（126 清单内具备视觉能力：qwen3.6-plus / qwen3.6-flash）
# MODEL_ROUTER_QA_SCOPE=all  # 默认全部五类图合规检测；white=仅白底兼容质检
# 可选：图生图（i2i）独立网关覆盖——仅用于诊断对比，留空则与主网关一致
# 注意：比赛交付配置必须留空（红线：所有调用走 Token Plan Model Router）；主机必须为公网 http(s) 地址
# MODEL_ROUTER_EDIT_BASE_URL=
# MODEL_ROUTER_EDIT_API_KEY=
# 图生图独立网关请求格式：openai-images=OpenAI Images API /images/edits（gpt-image 系列）；留空=chat（Token Plan 风格）
# MODEL_ROUTER_EDIT_API_STYLE=openai-images
